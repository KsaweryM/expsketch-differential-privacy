# Everything generated by the build lives here (LaTeX aux files, converted
# figures, minted cache, logs). Only thesis.pdf is copied to the root.
/build/

# Safety net: LaTeX by-products, in case something is compiled outside `make`
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.loa
*.lol
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.nav
*.snm
*.vrb
_minted*/
svg-inkscape/

# PDFs are build output, except the final thesis in the root
*.pdf
!/thesis.pdf

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
