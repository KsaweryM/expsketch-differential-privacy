#!/bin/sh
# Rebuild thesis.pdf before every commit and include it in the commit.
# Enable with:  make hooks   (sets git config core.hooksPath .githooks)
# Skip once with:  git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

# Nothing to do if no thesis sources are staged (e.g. README-only commits).
if ! git diff --cached --name-only | grep -qvE '^(README\.md|LICENSE|notes/|\.gitignore$|\.githooks/)'; then
    exit 0
fi

echo "pre-commit: rebuilding thesis.pdf ..."
mkdir -p build
if ! make pdf > build/pre-commit.log 2>&1; then
    echo "pre-commit: build failed, commit aborted. Errors:" >&2
    if [ -f build/thesis.log ] && grep -qE '^(\./.*:[0-9]+:|!)' build/thesis.log; then
        grep -E -A2 '^(\./.*:[0-9]+:|!)' build/thesis.log | head -n 20 >&2
    else
        tail -n 20 build/pre-commit.log >&2
    fi
    echo "pre-commit: full log in build/pre-commit.log and build/thesis.log" >&2
    exit 1
fi
git add thesis.pdf
echo "pre-commit: thesis.pdf updated and staged."
